# Copia questo file in ".env" (che NON va mai committato: è in .gitignore)
# e inserisci i tuoi valori. Su Vercel le stesse variabili si impostano in
# Project → Settings → Environment Variables.

# Obbligatoria: chiave API OpenAI usata da tutti gli endpoint AI.
OPENAI_API_KEY=sk-...la-tua-chiave...

# Interruttore di emergenza: con "true" tutti gli endpoint AI rispondono 503
# e non viene fatta nessuna chiamata a OpenAI. Lascia vuoto/assente in uso normale.
# AI_DISABLED=true

# Limiti orari per connessione (opzionali, valori di default indicati).
# RATE_LIMIT_GENERATE_PER_HOUR=15
# RATE_LIMIT_AI_ASK_PER_HOUR=40
# RATE_LIMIT_CHAT_PER_HOUR=20
